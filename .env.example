# Copie este arquivo para ".env" e preencha os valores.

# Necessário apenas para o comando gerar_scripts (usa a API da Anthropic/Claude)
ANTHROPIC_API_KEY=

# Opcionais - já vêm com valores padrão sensatos
# WHISPER_MODEL_SIZE=small      # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=cpu            # cpu | cuda
# WHISPER_COMPUTE_TYPE=int8     # int8 (cpu) | float16 (gpu)
# WHISPER_LANGUAGE=pt
# CLAUDE_MODEL=claude-sonnet-5
# PERFIL_USUARIO=@theo_vasc
# NICHO=Empreendedorismo, liderança empresarial e assessoria de marketing e vendas para centros automotivos
# TOM_DE_VOZ=Direto e didático
